    [ "esp:GND.2", "pot1:GND", "black", [ "v0" ] ],
    [ "esp:34", "pot1:SIG", "orange", [ "v0" ] ],
    [ "esp:13", "btn1:2.1", "yellow", [ "v0" ] ],
    [ "esp:GND.1", "btn1:1.1", "black", [ "v0" ] ],
    [ "esp:4", "r1:1", "red", [ "v0" ] ],
    [ "r1:2", "led_alert:A", "red", [ "v0" ] ],
    [ "esp:GND.2", "led_alert:C", "black", [ "v0" ] ]
