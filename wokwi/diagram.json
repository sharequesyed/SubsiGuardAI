    { "type": "wokwi-potentiometer", "id": "pot1", "top": 150, "left": 180, "attrs": { "label": "Crack Extensometer (mm)" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 180, "left": -120, "attrs": { "color": "red", "label": "Heavy Dumper Vibration" } },
